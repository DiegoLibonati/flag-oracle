#!/bin/sh
# Pre-commit hook for Flag Oracle monorepo.
# Runs ruff and mypy when flag-oracle-api files are staged.
# Runs lint-staged (eslint + prettier) when flag-oracle-app files are staged.

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

API_FILES=$(echo "$STAGED_FILES" | grep "^flag-oracle-api/")
APP_FILES=$(echo "$STAGED_FILES" | grep "^flag-oracle-app/")

EXIT_CODE=0

if [ -n "$API_FILES" ]; then
    API_DIR="$REPO_ROOT/flag-oracle-api"

    if [ -x "$API_DIR/venv/Scripts/python.exe" ]; then
        PYTHON="$API_DIR/venv/Scripts/python.exe"
    elif [ -x "$API_DIR/venv/bin/python" ]; then
        PYTHON="$API_DIR/venv/bin/python"
    else
        echo '[pre-commit] venv python not found at flag-oracle-api/venv/. Create it with `python -m venv venv` and `pip install -e ".[dev]"`.' 1>&2
        exit 1
    fi

    echo "[pre-commit] Running ruff check for flag-oracle-api..."
    "$PYTHON" -m ruff check --fix "$API_DIR"
    EXIT_CODE=$((EXIT_CODE + $?))

    echo "[pre-commit] Running ruff format for flag-oracle-api..."
    "$PYTHON" -m ruff format "$API_DIR"
    EXIT_CODE=$((EXIT_CODE + $?))

    echo "[pre-commit] Running mypy for flag-oracle-api..."
    "$PYTHON" -m mypy \
        --config-file="$API_DIR/pyproject.toml" \
        "$API_DIR"
    EXIT_CODE=$((EXIT_CODE + $?))
fi

if [ -n "$APP_FILES" ]; then
    echo "[pre-commit] Running lint-staged for flag-oracle-app..."
    if command -v npx > /dev/null; then
        (cd "$REPO_ROOT/flag-oracle-app" && npx --no-install lint-staged)
    else
        echo '[pre-commit] `npx` not found. Install Node.js to enable the frontend hook.' 1>&2
        exit 1
    fi
    EXIT_CODE=$((EXIT_CODE + $?))
fi

exit $EXIT_CODE
