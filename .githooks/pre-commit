#!/bin/sh
# Pre-commit hook for Flag Oracle monorepo.
# Runs ruff (via pre-commit) and mypy when flag-oracle-api files are staged.
# Runs lint-staged (eslint + prettier) when flag-oracle-app files are staged.

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES=$(git diff --cached --name-only)

API_FILES=$(echo "$STAGED_FILES" | grep "^flag-oracle-api/")
APP_FILES=$(echo "$STAGED_FILES" | grep "^flag-oracle-app/")

EXIT_CODE=0

if [ -n "$API_FILES" ]; then
    INSTALL_PYTHON="$REPO_ROOT/flag-oracle-api/venv/Scripts/python.exe"

    echo "[pre-commit] Running ruff for flag-oracle-api..."
    if [ -x "$INSTALL_PYTHON" ]; then
        "$INSTALL_PYTHON" -mpre_commit run \
            --config="$REPO_ROOT/flag-oracle-api/.pre-commit-config.yaml" \
            --hook-stage=pre-commit
    elif command -v pre-commit > /dev/null; then
        pre-commit run \
            --config="$REPO_ROOT/flag-oracle-api/.pre-commit-config.yaml" \
            --hook-stage=pre-commit
    else
        echo '[pre-commit] `pre-commit` not found. Did you forget to activate your virtualenv?' 1>&2
        exit 1
    fi
    EXIT_CODE=$((EXIT_CODE + $?))

    echo "[pre-commit] Running mypy for flag-oracle-api..."
    if [ -x "$INSTALL_PYTHON" ]; then
        "$INSTALL_PYTHON" -m mypy \
            --config-file="$REPO_ROOT/flag-oracle-api/pyproject.toml" \
            "$REPO_ROOT/flag-oracle-api"
    else
        echo '[pre-commit] venv python not found, skipping mypy.' 1>&2
    fi
    EXIT_CODE=$((EXIT_CODE + $?))
fi

if [ -n "$APP_FILES" ]; then
    echo "[pre-commit] Running lint-staged for flag-oracle-app..."
    if command -v npx > /dev/null; then
        (cd "$REPO_ROOT/flag-oracle-app" && npx --no-install lint-staged)
    else
        echo '[pre-commit] `npx` not found. Install Node.js to enable the frontend hook.' 1>&2
        exit 1
    fi
    EXIT_CODE=$((EXIT_CODE + $?))
fi

exit $EXIT_CODE
